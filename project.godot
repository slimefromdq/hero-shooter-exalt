[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Actors"
3d_physics/layer_3="Lantern team entrance"
3d_physics/layer_4="Crown team entrance"
3d_physics/layer_5="Shootable deployables"

[physics]

3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.65, 0.76, 0.78, 1)
