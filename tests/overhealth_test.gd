extends "res://tests/care_heroes_test.gd"
var heal_events: int = 0
var breaks: int = 0
var last_hit: float = 0
var killed_by: HeroActor
var credited_assistants: Array[HeroActor] = []

func run() -> void:
	world = Node3D.new()
	root.add_child(world)
	current_scene = world
	resolver = CombatResolver.new()
	world.add_child(resolver)
	Geometry.box(world,Vector3(150,1,150),Vector3(0,-.5,0),Color.GRAY)
	doctor = spawn("doctor",0,Vector3(3,.01,0))
	friend = spawn("nimbus",0,Vector3(0,.01,-8))
	enemy = spawn("nimbus",1,Vector3(0,.01,-16))
	marshal = spawn("marshal",0,Vector3(0,.01,0))
	hunter = spawn("slayer",1,Vector3(20,.01,0))
	second = spawn("doctor",0,Vector3(13,.01,0))
	var camera := Camera3D.new()
	world.add_child(camera)
	camera.position = Vector3(12,8,10)
	camera.look_at(Vector3(0,1,-4))
	camera.current = true
	resolver.confirmed_heal.connect(func(_a: HeroActor,_b: HeroActor,_n: float) -> void: heal_events += 1)
	resolver.confirmed_hit.connect(func(_a: HeroActor,_b: HeroActor,n: float,_h: bool,_e: bool) -> void: last_hit = n)
	resolver.elimination.connect(func(k: HeroActor,_v: HeroActor,a: Array[HeroActor],_tag: String) -> void:
		killed_by = k
		credited_assistants.assign(a))
	marshal.overhealth_broken.connect(func() -> void: breaks += 1)
	await step(3)
	await setup_command()
	var k := marshal.kit as MarshalKit
	k.ultimate_charge = 0
	command()
	near(marshal.overhealth.value(),175,"Rally grants Marshal 175 overhealth")
	near(friend.overhealth.value(),75,"Rally grants nearby ally 75 overhealth")
	near(second.overhealth.value(),0,"outside twelve metres receives nothing")
	near(enemy.overhealth.value(),0,"enemies receive no overhealth")
	second.position = Vector3(6,.01,0)
	marshal.kit.tick(0,marshal.intent)
	near(second.overhealth.value(),0,"entering radius after activation does not receive an aura grant")
	near(k.deflect_cd,12,"Rally has twelve-second cooldown")
	near(marshal.overhealth.remaining(),5,"Rally lasts five seconds")
	near(marshal.health,550,"Rally does not heal")
	near(marshal.benefits.damage_multiplier(),1,"Rally does not increase damage")
	near(marshal.benefits.speed_multiplier(),1,"Rally does not increase speed")
	check(heal_events == 0,"grant does not report healing or build heal charge")
	near(k.ultimate_charge,0,"Rally activation grants no ultimate charge")
	friend.position.z = -30
	friend.overhealth.tick(2)
	near(friend.overhealth.value(),75,"selected recipient keeps grant after leaving radius")
	friend.overhealth.tick(3)
	near(friend.overhealth.value(),0,"recipient grant expires at five seconds")
	await setup_command()
	friend.position = Vector3(12,.01,0)
	second.position = Vector3(12.01,.01,0)
	await step()
	command()
	near(friend.overhealth.value(),75,"radius boundary is eligible")
	near(second.overhealth.value(),0,"just outside radius is excluded")
	await setup_command()
	var wall: Node3D = Geometry.box(world,Vector3(6,4,.3),Vector3(0,1.8,-4),Color.GRAY)
	await step()
	command()
	near(friend.overhealth.value(),0,"solid world cover blocks Rally line of sight")
	wall.queue_free()
	await step()
	await setup_command()
	friend.spawn_protected = true
	second.position = Vector3(3,.01,0)
	second.die()
	command()
	near(friend.overhealth.value(),0,"protected ally is excluded")
	near(second.overhealth.value(),0,"dead ally is excluded")
	await setup_command()
	marshal.state = "marshal_shield"
	marshal.intent.secondary_held = true
	command()
	check(marshal.state == "marshal_shield" and k.barrier.active(),"Rally preserves held barrier")
	await setup_command()
	marshal.state = "guard"
	command()
	check(marshal.state == "guard" and marshal.overhealth.value() == 175,"Rally preserves defensive guard")
	for forbidden: String in ["stagger","captured","throw_pair","marshal_march","marshal_verdict","marshal_recovery","melee_windup"]:
		await setup_command()
		marshal.state = forbidden
		marshal.state_time = 1
		command()
		check(marshal.overhealth.value() == 0 and k.deflect_cd == 0,"Rally refuses committed/disabled state "+forbidden)
		k.rally()
		check(marshal.overhealth.value() == 0 and k.deflect_cd == 0,"direct Rally activation also validates state "+forbidden)
	await setup_command()
	marshal.motor.transition("dash",.3)
	command()
	check(marshal.overhealth.value() == 0 and k.deflect_cd == 0,"Rally cannot override a universal dash commitment")
	await setup_command()
	marshal.statuses.apply("root",enemy,1)
	command()
	near(marshal.overhealth.value(),175,"root still permits an instant defensive Rally")
	await setup_command()
	marshal.state = "marshal_shield"
	marshal.spawn_protected = true
	command()
	near(marshal.overhealth.value(),0,"shield state cannot bypass spawn attack lock")
	await setup_command()
	command()
	marshal.shields = 40
	hurt(marshal,125)
	near(marshal.overhealth.value(),50,"damage consumes overhealth first")
	near(marshal.shields,40,"overhealth protects personal shields")
	near(marshal.health,550,"overhealth protects base health")
	var previous_breaks: int = breaks
	hurt(marshal,100)
	near(marshal.overhealth.value(),0,"overflow exhausts overhealth")
	near(marshal.shields,0,"overflow consumes personal shields second")
	near(marshal.health,540,"remaining overflow reaches health last")
	check(breaks == previous_breaks+1,"depletion emits one break event")
	check(marshal.presentation.overhealth_visual.break_left > 0,"break event synchronizes armor fracture")
	var cast: int = resolver.new_cast(enemy)
	resolver.damage(enemy,marshal,10,"rifle",cast)
	var after: float = marshal.health
	resolver.damage(enemy,marshal,10,"rifle",cast)
	near(marshal.health,after,"duplicate damage casts remain deduplicated")
	await setup_command()
	command()
	marshal.benefits.grant("prescription",doctor,3,.5)
	hurt(marshal,100)
	near(marshal.overhealth.value(),125,"existing damage reduction precedes overhealth absorption")
	await setup_command()
	marshal.overhealth.grant(doctor,100,5)
	marshal.overhealth.tick(2)
	hurt(marshal,40)
	check(not marshal.overhealth.grant(doctor,500,20),"same source cannot replenish or refresh an active grant")
	near(marshal.overhealth.value(),60,"rejected grant retains depleted value")
	near(marshal.overhealth.remaining(),3,"rejected grant retains original deadline")
	hurt(marshal,60)
	check(not marshal.overhealth.grant(doctor,100,5),"depleted grant keeps source lock until original expiry")
	marshal.overhealth.tick(3)
	check(marshal.overhealth.grant(doctor,100,5),"source can grant again after original expiry")
	await setup_command()
	marshal.overhealth.grant(doctor,100,2)
	marshal.overhealth.grant(friend,75,5)
	near(marshal.overhealth.value(),100,"different sources use strongest grant, never additive")
	hurt(marshal,40)
	near(marshal.overhealth.value(),60,"absorbed damage reduces effective pool")
	marshal.overhealth.tick(2)
	near(marshal.overhealth.value(),35,"weaker grant was also depleted and cannot act as a refill")
	marshal.overhealth.grant(second,175,1)
	near(marshal.overhealth.value(),175,"fresh stronger source upgrades pool")
	marshal.overhealth.tick(1)
	near(marshal.overhealth.value(),35,"stronger grant expires on its own deadline")
	await setup_command()
	friend.health = 100
	friend.overhealth.grant(marshal,75,5)
	near(resolver.heal(doctor,friend,25,"test"),21.875,"ordinary healing restores ordinary missing health")
	near(friend.health,121.875,"healing restores HP")
	near(friend.overhealth.value(),75,"healing cannot increase overhealth")
	hurt(friend,50)
	friend.health = friend.effective_max_health()
	near(resolver.heal(doctor,friend,100,"test"),0,"missing overhealth does not count as healable damage")
	near(friend.overhealth.value(),25,"full-health healing cannot replenish depleted overhealth")
	await setup_command()
	command()
	enemy.kit.ultimate_charge = 0
	hurt(marshal,50)
	near(enemy.kit.ultimate_charge,4.5 / 1.4,"overhealth damage awards normal ultimate charge")
	near(last_hit,50,"confirmed hit includes overhealth absorption")
	check(resolver.contributions[marshal.get_instance_id()].has(enemy.get_instance_id()),"overhealth damage records attacker credit")
	check(resolver.events.any(func(entry: Dictionary) -> bool: return entry.event == "damage" and entry.details.contains("overhealth=50.0")),"combat event reports absorption breakdown")
	hurt(marshal,1000)
	check(killed_by == enemy,"overflow elimination preserves damage attribution")
	near(marshal.overhealth.value(),0,"death clears overhealth")
	await setup_command()
	friend.overhealth.grant(marshal,75,5)
	resolver.damage(hunter,friend,25,"rifle",resolver.new_cast(hunter))
	hurt(friend,1000)
	check(killed_by == enemy and credited_assistants.has(hunter),"overhealth-only attacker retains assist credit on a later elimination")
	await setup_command()
	friend.health = 20
	friend.overhealth.grant(marshal,75,5)
	var result: String = resolver.damage(enemy,friend,10,"ultimate",resolver.new_cast(enemy),false,true)
	check(result == "hit" and friend.alive and friend.health == 20,"overhealth blocks execution without altering base-health threshold")
	friend.overhealth.absorb(65)
	result = resolver.damage(enemy,friend,10,"ultimate",resolver.new_cast(enemy),false,true)
	check(result == "execution" and not friend.alive,"ordinary low-health execution returns after overhealth is gone")
	await setup_command()
	command()
	friend.presentation.health_bar.refresh()
	check(friend.presentation.health_bar.overhealth_fill.visible,"ally overhead bar shows overhealth segment")
	check(friend.presentation.health_bar.caption.text.contains("+75 OH"),"overhead bar reports exact overhealth")
	check(marshal.presentation.overhealth_visual.armor.visible,"character armor accents synchronize immediately on grant")
	check(CareHUD.status(friend).contains("OVERHEALTH +75"),"shared status feedback reports numeric overhealth")
	friend.overhealth.tick(5)
	check(not friend.presentation.overhealth_visual.armor.visible,"expiry removes armor effect without break")
	await step(2)
	friend.presentation.health_bar.refresh()
	check(not friend.presentation.health_bar.overhealth_fill.visible,"expiry removes overhead overhealth segment")
	marshal.reset_actor(Vector3(0,.01,0))
	near(marshal.overhealth.value(),0,"respawn/reset clears local grants")
	near(doctor.overhealth.value(),0,"source reset clears owned ally grants")
	command()
	marshal.die()
	near(friend.overhealth.value(),0,"source death clears owned ally grants")
	await setup_command()
	command()
	friend.die()
	near(friend.overhealth.value(),0,"recipient death clears grants immediately")
	near(doctor.overhealth.value(),75,"recipient death does not revoke other allies' grants")
	await setup_command()
	command()
	marshal.select_hero("relay")
	near(marshal.overhealth.value(),0,"hero switching clears old overhealth")
	check(not marshal.presentation.overhealth_visual.armor.visible,"hero switching creates clean universal visuals")
	marshal.select_hero("marshal")
	k = marshal.kit as MarshalKit
	await setup_command()
	command()
	resolver.clear_round()
	near(friend.overhealth.value(),0,"match reset clears temporary health on every actor")
	check(marshal.presentation.overhealth_visual.pulses.is_empty(),"match reset retires activation pulses and command audio")
	await setup_command()
	enemy.position = Vector3(0,.01,-18)
	friend.position = Vector3(3,.01,-8)
	await step()
	check(not CareTactics.rally_worthwhile(marshal),"AI saves Rally without credible attack or imminent engagement")
	enemy.intent.primary_held = true
	check(CareTactics.rally_worthwhile(marshal),"AI rallies nearby allies under credible enemy fire")
	command()
	check(not CareTactics.rally_worthwhile(marshal),"AI cannot waste Rally during cooldown")
	k.deflect_cd = 0
	check(not CareTactics.rally_worthwhile(marshal),"AI avoids reapplying locked or already sufficient grants")
	await setup_command()
	friend.position = Vector3(30,.01,0)
	doctor.position = Vector3(-30,.01,0)
	enemy.intent.primary_held = true
	check(not CareTactics.rally_worthwhile(marshal),"healthy isolated AI saves team defensive cooldown")
	marshal.health = 200
	marshal.last_hit_age = .5
	check(CareTactics.rally_worthwhile(marshal),"injured AI can use Rally for credible emergency self-defense")
	for id: String in HeroRoster.IDS:
		await setup_command()
		friend.select_hero(id)
		friend.overhealth.grant(marshal,75,5)
		hurt(friend,25)
		near(friend.overhealth.value(),50,"universal overhealth works on "+id)
		check(friend.presentation.overhealth_visual.armor.visible,"universal armor works on "+id)
		friend.reset_actor(Vector3(0,.01,-8))
		check(friend.overhealth.value() == 0 and not friend.presentation.overhealth_visual.armor.visible,"universal reset cleanup on "+id)
	check(ProceduralSound.rally_shout().data.size() > 20000,"voice-like command has a finite synthesized audio cue")
	print("RESULT: %d checks, %d failures" % [checks,failures.size()])
	world.queue_free()
	await step()
	quit(0 if failures.is_empty() else 1)

func setup_command() -> void:
	await reset()
	marshal.position = Vector3(0,.01,0)
	doctor.position = Vector3(3,.01,0)
	friend.position = Vector3(0,.01,-8)
	enemy.position = Vector3(0,.01,-16)
	second.position = Vector3(13,.01,0)
	for a: HeroActor in [marshal,doctor,friend,enemy,hunter,second]:
		a.spawn_protected = false
		a.last_hit_age = 99
	marshal.intent = CombatIntent.new()
	enemy.intent = CombatIntent.new()
	await step()

func command() -> void:
	marshal.intent.deflect = true
	marshal.kit.tick(0,marshal.intent)
	marshal.intent.deflect = false

func hurt(target: HeroActor, amount: float) -> void:
	resolver.damage(enemy,target,amount,"rifle",resolver.new_cast(enemy))
