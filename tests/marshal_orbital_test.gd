extends "res://tests/care_heroes_test.gd"

func run() -> void:
	world = Node3D.new()
	root.add_child(world)
	current_scene = world
	resolver = CombatResolver.new()
	world.add_child(resolver)
	Geometry.box(world,Vector3(150,1,150),Vector3(0,-.5,0),Color.GRAY)
	doctor = spawn("doctor",0,Vector3(-30,0,0))
	friend = spawn("nimbus",0,Vector3(-30,0,5))
	enemy = spawn("nimbus",1,Vector3(0,.01,-2))
	marshal = spawn("marshal",0,Vector3(0,.01,0))
	hunter = spawn("slayer",1,Vector3(0,.01,-8))
	second = spawn("doctor",0,Vector3(-30,0,10))
	await setup_lane()
	var k := marshal.kit as MarshalKit
	check(MarshalOrbitalTargeting.can_strike(marshal,Vector3.FORWARD,enemy.body_point(.9)),"AI recognizes an exposed enemy on a legitimate orbital lane")
	cast_barrage()
	check(k.orbital_points.size() == 10,"orbital lane retains ten ground strike positions")
	near(Vector3(k.orbital_points[-1].position).z,-20,"orbital lane retains twenty-metre length")
	near(k.bomb_cd,10,"orbital cooldown stays ten seconds")
	var downward: Array[Dictionary] = MarshalOrbitalTargeting.plan(marshal,marshal.position,Vector3(0,-1,-1).normalized())
	check(downward.size() == 10,"downward aim projects onto terrain rather than shortening the lane beneath the floor")
	for entry: Dictionary in k.orbital_points:
		check(bool(entry.valid) and absf(entry.position.y) < .02,"marker is grounded on real terrain")
	near(enemy.health,250,"markers cause no damage")
	var first: MarshalOrbitalEffect = k.orbital_effects[0]
	check(first.marker.visible and not first.column.visible,"gold telegraph is distinct from damaging column")
	first._process(.3)
	check(first.ray_mesh.visible and not first.column.visible,"brief descending targeting ray precedes impact")
	k.tick(.39,marshal.intent)
	near(enemy.health,250,"orbital warning remains damage free")
	k.tick(.02,marshal.intent)
	near(enemy.health,175,"first authoritative grounded strike deals seventy-five")
	check(first.column.visible and first.impact_age == 0,"damaging beam begins only at authoritative strike")
	near(hunter.health,hunter.tuning.max_health,"later targets wait for sequential impacts")
	k.tick(.8,marshal.intent)
	near(enemy.health,175,"overlapping orbital blasts damage each target once per cast")
	near(hunter.health,hunter.tuning.max_health-75,"later advancing strike reaches its own target")
	check(k.breach_age < 0,"completed barrage retires its scheduler")
	await setup_lane()
	var roof: Node3D = Geometry.box(world,Vector3(10,.3,30),Vector3(0,4,-10),Color.GRAY)
	await step()
	cast_barrage()
	check(k.orbital_points.all(func(entry: Dictionary) -> bool: return not entry.valid),"solid roof invalidates covered ground markers")
	check(not MarshalOrbitalTargeting.can_strike(marshal,Vector3.FORWARD,enemy.body_point(.9)),"AI rejects a roof-covered orbital engagement")
	k.tick(2,marshal.intent)
	near(enemy.health,250,"orbital beams cannot penetrate a roof")
	roof.queue_free()
	await step()
	await setup_lane()
	cast_barrage()
	roof = Geometry.box(world,Vector3(10,.3,30),Vector3(0,4,-10),Color.GRAY)
	await step()
	k.tick(2,marshal.intent)
	near(enemy.health,250,"roof added after telegraph blocks damage at impact time")
	check(not is_instance_valid(k.orbital_effects[0]) or k.orbital_effects[0].is_queued_for_deletion(),"invalidated strike removes its warning instead of showing a false impact")
	roof.queue_free()
	await step()
	await setup_lane()
	var wall: Node3D = Geometry.box(world,Vector3(8,6,.1),Vector3(0,3,-4),Color.GRAY)
	enemy.position.z = -8
	await step()
	cast_barrage()
	check(k.orbital_points.size() < 10,"wall clips the planned advancing lane")
	check(not MarshalOrbitalTargeting.can_strike(marshal,Vector3.FORWARD,enemy.body_point(.9)),"AI rejects a target beyond a blocking wall")
	k.tick(2,marshal.intent)
	near(enemy.health,250,"solid wall protects targets behind the clipped lane")
	wall.queue_free()
	await step()
	await setup_lane()
	cast_barrage()
	wall = Geometry.box(world,Vector3(8,6,.1),Vector3(0,3,-1),Color.GRAY)
	await step()
	k.tick(2,marshal.intent)
	near(enemy.health,250,"new wall between caster and first marker stops the barrage")
	check(k.breach_age < 0,"new obstacle cancels future impacts")
	wall.queue_free()
	await step()
	await setup_lane()
	roof = Geometry.box(world,Vector3(2,.3,30),Vector3(1.1,4,-10),Color.GRAY)
	await step()
	cast_barrage()
	check(k.orbital_points.all(func(entry: Dictionary) -> bool: return not entry.valid),"column volume rejects a roof edge even when the centre ray is clear")
	roof.queue_free()
	await step()
	await setup_lane()
	var platform: Node3D = Geometry.box(world,Vector3(12,1,45),Vector3(0,3.5,-10),Color.GRAY)
	marshal.position.y = 4.01
	enemy.position.y = 4.01
	await step()
	cast_barrage()
	check(k.orbital_points.all(func(entry: Dictionary) -> bool: return entry.valid and absf(entry.position.y-4) < .02),"platform strikes stay on the targeted upper floor")
	k.tick(2,marshal.intent)
	near(enemy.health,175,"elevated platform receives legitimate ground impact")
	platform.queue_free()
	await step()
	await setup_lane()
	var ramp: Node3D = Geometry.box(world,Vector3(8,.4,28),Vector3(0,.8,-10),Color.GRAY)
	ramp.rotation.x = .08
	await step()
	cast_barrage()
	check(k.orbital_points.size() >= 8,"walkable slope retains an advancing strike lane")
	check(k.orbital_points[5].position.y > k.orbital_points[0].position.y,"ground markers follow actual slope elevations")
	check(k.orbital_points[0].normal.y < 1 and k.orbital_points[0].normal.y > .9,"slope telegraph retains the surface normal")
	ramp.queue_free()
	await step()
	await setup_lane()
	var defender: HeroActor = spawn("marshal",1,Vector3(0,.01,-6))
	defender.aim_direction = Vector3.BACK
	defender.state = "marshal_shield"
	(defender.kit as MarshalKit).barrier_hp = 10
	await step()
	cast_barrage()
	k.tick(2,marshal.intent)
	near(defender.health,550,"breaking hostile barrier still protects owner from the cast")
	near((defender.kit as MarshalKit).barrier_hp,0,"barrier absorbs orbital impact through existing resolver")
	check(k.breach_age < 0,"hostile barrier retires advancing barrage")
	defender.queue_free()
	await step()
	await setup_lane()
	defender = spawn("marshal",1,Vector3(0,.01,-2))
	defender.aim_direction = Vector3.UP
	defender.state = "marshal_shield"
	(defender.kit as MarshalKit).barrier_hp = 10
	await step()
	cast_barrage()
	k.tick(2,marshal.intent)
	near(defender.health,550,"upward-facing barrier intercepts orbital column before any ground damage")
	near((defender.kit as MarshalKit).barrier_hp,0,"overhead barrier absorbs incoming orbital energy even when it breaks")
	defender.queue_free()
	await step()
	await setup_lane()
	cast_barrage()
	marshal.close.stagger()
	k.tick(1.5,marshal.intent)
	near(enemy.health,175,"ordinary crowd control does not accidentally cancel a committed barrage")
	await setup_lane()
	cast_barrage()
	marshal.reset_actor(Vector3(0,.01,0))
	check(k.orbital_points.is_empty() and k.orbital_effects.is_empty() and k.breach_age < 0,"reset clears scheduler and all owned orbital markers")
	await step(4)
	check(get_nodes_in_group("marshal_orbital_effects").is_empty(),"orbital marker lifecycle leaves no stale world effects")
	await setup_lane()
	var p: MarshalCombatPresentation = marshal.presentation.marshal_combat
	k.fire(false)
	check(p.flash_mesh.visible and p.shot_age == 0,"cannon responds with an immediate muzzle flash")
	near(k.shot_cd,1.1,"presentation polish preserves cannonball cadence")
	near(k.ammo,3,"presentation polish preserves four-round magazine")
	p._process(.08)
	check(not p.flash_mesh.visible,"short muzzle flash clears without obstructing aim")
	k.shot_cd = 0
	k.start_reload()
	p._process(.01)
	check(p.reload_was_active,"reload presentation tracks authoritative reload state")
	k.tick_reload(1.8)
	p._process(.01)
	check(not p.reload_was_active,"reload feedback completes with the real reload")
	marshal.state = "marshal_shield"
	k.barrier._process(.1)
	check(k.barrier.active() and k.barrier.appearance == 1,"barrier blocks immediately while its visual raises smoothly")
	var original: Vector2 = k.barrier.dimensions()
	k.barrier.receive_damage(enemy,800,resolver.new_cast(enemy))
	k.barrier._process(.01)
	check(k.barrier.cracks.any(func(mesh: MeshInstance3D) -> bool: return mesh.visible),"low barrier durability reveals crack patterns")
	check(k.barrier.dimensions() == original,"damage visuals never alter analytic blocking dimensions")
	check((k.barrier.segments[0].material_override as StandardMaterial3D).emission_energy_multiplier > 0 and (k.barrier.segments[9].material_override as StandardMaterial3D).emission_energy_multiplier == 0,"spent durability segments stop glowing instead of retaining stale emission")
	k.barrier.receive_damage(enemy,500,resolver.new_cast(enemy))
	k.barrier._process(.01)
	check(not k.barrier.active() and k.barrier.fragments.visible,"barrier break stops blocking and presents short fragments")
	marshal.reset_actor()
	check(not k.barrier.visible and k.barrier.break_flash == 0,"reset clears barrier fragments and fade state")
	for cue: String in ["cannon","cannon_hit","cannon_blast","orbital","barrier_raise","barrier_lower","barrier_hit","barrier_break","barrier_ready","reload_start","reload_end"]:
		var wave: AudioStreamWAV = ProceduralSound.marshal_cue(cue)
		check(wave == ProceduralSound.marshal_cue(cue) and wave.data.size() > 4000,"bounded cached Marshal audio: "+cue)
	check(p.orbital_voices.size() == 4,"rapid orbital impacts use four reusable audio voices")
	for index: int in 60: p.orbital_marker({"valid":true,"position":Vector3(25,0,25),"normal":Vector3.UP,"delay":.4},2)
	check(get_nodes_in_group("marshal_orbital_effects").size() <= MarshalOrbitalEffect.MAX_WORLD,"orbital visual population has a hard world cap")
	print("RESULT: %d checks, %d failures" % [checks,failures.size()])
	world.queue_free()
	await step()
	quit(0 if failures.is_empty() else 1)

func setup_lane() -> void:
	await reset()
	marshal.position = Vector3(0,.01,0)
	doctor.position = Vector3(-30,.01,0)
	friend.position = Vector3(-30,.01,5)
	second.position = Vector3(-30,.01,10)
	enemy.position = Vector3(0,.01,-2)
	hunter.position = Vector3(0,.01,-8)
	marshal.intent = CombatIntent.new()
	marshal.aim_direction = Vector3.FORWARD
	for a: HeroActor in [marshal,doctor,friend,second,enemy,hunter]: a.spawn_protected = false
	await step()

func cast_barrage() -> void:
	marshal.intent.bomb = true
	marshal.kit.tick(0,marshal.intent)
	marshal.intent.bomb = false
